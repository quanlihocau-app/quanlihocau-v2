# Mẫu biến cho VPS tự host. Copy thành .env trên máy, chmod 600.
# Không điền mật khẩu thật vào file này. Không commit file .env.

# --- Postgres trong Docker ---
POSTGRES_USER=quanlihocau
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=quanlihocau
# Host là tên service `db`, không phải localhost. Tránh ký tự @ : / # trong mật khẩu
# hoặc phải mã hóa URL trước khi dán vào chuỗi này.
DATABASE_URL=postgresql://quanlihocau:replace-with-a-long-random-password@db:5432/quanlihocau?schema=public

# --- Ứng dụng ---
NODE_ENV=production
NEXTAUTH_URL=https://quanlihocau.com
NEXTAUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
AUTH_SECRET=replace-with-a-different-openssl-rand-base64-32
SESSION_SECRET=replace-with-a-third-openssl-rand-base64-32
CRON_SECRET=replace-with-output-of-openssl-rand-base64-32
# Cron trong container gọi http://app:3000. Không sửa thành domain công khai.
APP_BASE_URL=http://app:3000

# --- Google (giữ redirect https://quanlihocau.com/api/auth/callback/google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with Apple. Để trống thì nút Apple trên web không hiện. ---
# APPLE_ID là Services ID. APPLE_BUNDLE_ID là id app iOS.
APPLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=com.quanlihocau.app
# Nội dung file .p8, thay dòng mới bằng \n. Không dán file thật vào git.
APPLE_PRIVATE_KEY=

# --- Webhook ngân hàng ---
BANK_WEBHOOK_SECRET=replace-with-output-of-openssl-rand-base64-32

# --- OTP. Để trống thì production không gửi SMS thật. ---
OTP_PROVIDER=
SPEEDSMS_AUTH_TOKEN=
SPEEDSMS_APP_ID=
SPEEDSMS_SENDER=
SMS_PROVIDER_API_KEY=
SMS_BRANDNAME=
ZALO_ZNS_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=

# --- Caddy ---
ACME_EMAIL=replace-with-a-real-mailbox@quanlihocau.com
SITE_ADDRESS=quanlihocau.com
SITE_WWW=www.quanlihocau.com

# --- Backup ra khỏi VPS. Mặc định rclone/Google Drive. S3 khi BACKUP_TARGET=s3. ---
# PRE_DEPLOY_BACKUP=0 cho đến khi rclone hoặc bucket đã thử thành công.
PRE_DEPLOY_BACKUP=0
BACKUP_TARGET=rclone
RCLONE_REMOTE=gdrive:quanlihocau-backups
# File trên host, chmod 600, không commit. Compose gắn read-only vào container.
RCLONE_CONFIG_PATH=/opt/quanlihocau/secrets/rclone.conf
S3_BUCKET=
S3_ENDPOINT=https://replace-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=quanlihocau
BACKUP_RETENTION_DAYS=14
BACKUP_WEEKLY_KEEP=8
# Khóa công khai age, tùy chọn. Để trống thì bản dump chỉ nén gzip.
BACKUP_AGE_RECIPIENT=

# --- Máy kéo ảnh riêng tư từ GHCR. Bỏ trống nếu package public. ---
GHCR_PULL_USER=
GHCR_PULL_TOKEN=
