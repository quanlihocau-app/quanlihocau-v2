# ==============================================================================
# VERCEL PRODUCTION ENVIRONMENT VARIABLES (.env.production.example)
# Dự án: Quản Lý Hồ Câu V2
# Hướng dẫn: Copy các cặp KEY=VALUE bên dưới và dán vào Vercel Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (BẮT BUỘC - Chuỗi kết nối PostgreSQL trên Cloud: Neon, Supabase, Railway)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST].neon.tech/quanlihocau?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH / XÁC THỰC BẢO MẬT (BẮT BUỘC)
# ------------------------------------------------------------------------------
# URL tên miền chính thức chạy Production
NEXTAUTH_URL="https://quanlihocau.com"

# Khóa bí mật mã hóa JWT (Tạo chuỗi ngẫu nhiên bằng lệnh: openssl rand -base64 32)
NEXTAUTH_SECRET="f4c9a8e2b7d1e6c3a5f8b9d0e1a2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0"

# ------------------------------------------------------------------------------
# 3. WEBHOOK & THANH TOÁN TECHCOMBANK VIETQR (BẮT BUỘC CHO SAAS)
# ------------------------------------------------------------------------------
# Khóa bí mật xác thực webhook từ cổng ngân hàng / Casso / SePay
BANK_WEBHOOK_SECRET="sk_live_bank_webhook_secret_key_change_me"

# Cấu hình tài khoản thụ hưởng mặc định
NEXT_PUBLIC_BANK_ID="TCB"
NEXT_PUBLIC_BANK_BIN="970407"
NEXT_PUBLIC_BANK_NAME="Techcombank"
NEXT_PUBLIC_BANK_ACCOUNT="8799999990"
NEXT_PUBLIC_BANK_ACCOUNT_NAME="TRAN ANH HUAN"
NEXT_PUBLIC_HOTLINE="0855550813"

# ------------------------------------------------------------------------------
# 4. SMS OTP PROVIDER (TÙY CHỌN - ĐỂ TRỐNG NẾU DÙNG CONSOLE/DEV)
# ------------------------------------------------------------------------------
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SECRET=""
SMS_BRANDNAME="QuanLyHoCau"

# ------------------------------------------------------------------------------
# 5. NODE ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="production"
