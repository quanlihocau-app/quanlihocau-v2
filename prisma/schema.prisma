// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum SystemRole {
  USER
  SUPER_ADMIN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE_PERIOD
  SUSPENDED
}

enum PlanTier {
  TRIAL
  SILVER
  GOLD
}

enum SubscriptionOrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PAID
  PARTIALLY_PAID
  VOIDED
}

enum PaymentTiming {
  PREPAID
  POSTPAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentDirection {
  IN
  OUT
}

enum FinancialTransactionType {
  RECEIPT
  EXPENSE
}

enum FinancialTransactionStatus {
  DRAFT
  APPROVED
  CANCELLED
  REVERSED
}

enum FinancialAccountType {
  CASH
  BANK
  WALLET
}

enum DebtType {
  RECEIVABLE
  PAYABLE
}

enum DebtStatus {
  PENDING
  PARTIAL
  SETTLED
  OVERDUE
  CANCELLED
}

// -----------------------------------------------------------------------------
// CORE & TENANT
// -----------------------------------------------------------------------------

model Organization {
  id               String              @id @default(uuid())
  name             String
  subscriptionPlan PlanTier            @default(TRIAL)
  validUntil       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  lakes              Lake[]
  subscriptionOrders SubscriptionOrder[]
}


  id                     String              @id @default(uuid())
  organizationId         String
  name                   String
  contactPhone           String?
  bankCode               String?
  bankName               String?
  bankAccountNumber      String?
  bankAccountName        String?
  allowNegativeInventory Boolean             @default(false)
  // SHA-256 of the optional read-only bot token. Null until the owner creates one.
  // The plaintext token is never stored.
  auditReadTokenHash     String?             @unique
  subscriptionStatus     SubscriptionStatus  @default(TRIAL)
  subscriptionPlan       PlanTier            @default(TRIAL)
  subscriptionExpiresAt  DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  deletedAt              DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])

  memberships        Membership[]
  customers          Customer[]
  areas              Area[]
  huts               Hut[]
  packages           Package[]
  fishingSessions    FishingSession[]
  products           Product[]
  inventoryMovements InventoryMovement[]
  invoices           Invoice[]
  payments           Payment[]
  expenses           Expense[]
  fishTypes          FishType[]
  fishBuybacks       FishBuyback[]
  shifts             Shift[]
  auditEvents           AuditEvent[]
  idempotencyKeys       IdempotencyKey[]
  subscriptionOrders    SubscriptionOrder[]
  financialCategories   FinancialCategory[]
  financialAccounts     FinancialAccount[]
  financialTransactions FinancialTransaction[]
  fundTransfers         FundTransfer[]
  debts                 Debt[]
  financialPeriods      FinancialPeriod[]
  reconciliations       ReconciliationRecord[]
  printJobs             PrintJob[]

  @@index([subscriptionStatus])
  @@index([subscriptionExpiresAt])
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  name            String
  phone           String?    @unique
  phoneVerified   Boolean    @default(false)
  phoneVerifiedAt DateTime?
  passwordHash    String?
  systemRole      SystemRole @default(USER)
  isLocked        Boolean    @default(false)
  lockedAt        DateTime?
  lockedReason    String?
  lastLoginAt     DateTime?
  sessionVersion  Int        @default(1)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships                  Membership[]
  createdFinancialTransactions FinancialTransaction[] @relation("CreatedTransactions")
  approvedFinancialTransactions FinancialTransaction[] @relation("ApprovedTransactions")

  @@index([createdAt])
  @@index([isLocked])
  @@index([lastLoginAt])
}

model Membership {
  id        String @id @default(uuid())
  userId    String
  lakeId    String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])
  lake Lake @relation(fields: [lakeId], references: [id])

  // Ensure a user cannot have duplicate membership in same lake
  @@unique([userId, lakeId])

  // Owner is now tracked via LakeOwner model; other roles can repeat
}

  id        String    @id @default(uuid())
  userId    String
  lakeId    String
  role      Role
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id])
  lake Lake @relation(fields: [lakeId], references: [id])

  @@unique([userId, lakeId])

  // Ensure only one OWNER (or any given role) per lake

}

// -----------------------------------------------------------------------------
// CUSTOMER
// -----------------------------------------------------------------------------

model Customer {
  id              String    @id @default(uuid())
  lakeId          String
  name            String
  phoneNormalized String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  lake            Lake             @relation(fields: [lakeId], references: [id])
  fishingSessions       FishingSession[]
  invoices              Invoice[]
  debts                 Debt[]
  financialTransactions FinancialTransaction[]

  @@unique([lakeId, phoneNormalized])
  @@index([lakeId, createdAt])
}

// -----------------------------------------------------------------------------
// FACILITIES & PRICING
// -----------------------------------------------------------------------------

model Area {
  id        String    @id @default(uuid())
  lakeId    String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lake Lake  @relation(fields: [lakeId], references: [id])
  huts Hut[]

  @@index([lakeId, createdAt])
}

model Hut {
  id               String    @id @default(uuid())
  lakeId           String
  areaId           String
  name             String
  currentSessionId String?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  lake           Lake                @relation(fields: [lakeId], references: [id])
  area           Area                @relation(fields: [areaId], references: [id])
  currentSession FishingSession?     @relation("CurrentHutSession", fields: [currentSessionId], references: [id])
  sessionLinks   FishingSessionHut[]

  @@index([lakeId, createdAt])
}

model Package {
  id                String    @id @default(uuid())
  lakeId            String
  name              String
  durationMinutes   Int
  priceVnd          Int
  overtimeHourlyVnd Int
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  lake            Lake             @relation(fields: [lakeId], references: [id])
  fishingSessions FishingSession[]

  @@index([lakeId, createdAt])
}

// -----------------------------------------------------------------------------
// OPERATIONS (FISHING SESSIONS)
// -----------------------------------------------------------------------------

model FishingSession {
  id           String        @id @default(uuid())
  lakeId       String
  customerId   String?
  packageId    String
  startAt      DateTime
  plannedEndAt DateTime
  endedAt      DateTime?
  status       SessionStatus
  version      Int           @default(1)

  packageNameSnapshot            String
  packageDurationMinutesSnapshot Int
  packagePriceVndSnapshot        Int
  overtimeHourlyVndSnapshot      Int
  paymentTiming                  PaymentTiming @default(POSTPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lake     Lake      @relation(fields: [lakeId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  package  Package   @relation(fields: [packageId], references: [id])
  invoices Invoice[]

  hutLinks     FishingSessionHut[]
  activeInHuts Hut[]               @relation("CurrentHutSession")

  @@index([lakeId, status])
  @@index([lakeId, createdAt])
}

model FishingSessionHut {
  id               String   @id @default(uuid())
  lakeId           String
  fishingSessionId String
  hutId            String
  createdAt        DateTime @default(now())

  fishingSession FishingSession @relation(fields: [fishingSessionId], references: [id])
  hut            Hut            @relation(fields: [hutId], references: [id])

  @@unique([fishingSessionId, hutId])
}

// -----------------------------------------------------------------------------
// INVENTORY
// -----------------------------------------------------------------------------

model Product {
  id        String    @id @default(uuid())
  lakeId    String
  sku       String?
  name      String
  priceVnd  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lake         Lake                @relation(fields: [lakeId], references: [id])
  movements    InventoryMovement[]
  invoiceLines InvoiceLine[]

  @@unique([lakeId, sku])
  @@index([lakeId, createdAt])
}

model InventoryMovement {
  id        String   @id @default(uuid())
  lakeId    String
  productId String
  quantity  Decimal
  reason    String
  createdBy String
  createdAt DateTime @default(now())

  lake    Lake    @relation(fields: [lakeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([lakeId, createdAt])
}

// -----------------------------------------------------------------------------
// FISHING RESULTS (BUYBACK)
// -----------------------------------------------------------------------------

model FishType {
  id         String    @id @default(uuid())
  lakeId     String
  name       String
  pricePerKg Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  lake     Lake          @relation(fields: [lakeId], references: [id])
  buybacks FishBuyback[]

  @@index([lakeId, createdAt])
}

model FishBuyback {
  id         String   @id @default(uuid())
  lakeId     String
  fishTypeId String
  weight     Decimal
  pricePerKg Int
  totalVnd   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lake         Lake          @relation(fields: [lakeId], references: [id])
  fishType     FishType      @relation(fields: [fishTypeId], references: [id])
  invoiceLines InvoiceLine[]

  @@index([lakeId, createdAt])
}

// -----------------------------------------------------------------------------
// FINANCIAL TRANSACTIONS
// -----------------------------------------------------------------------------

model Invoice {
  id               String        @id @default(uuid())
  lakeId           String
  customerId       String?
  fishingSessionId String?
  status            InvoiceStatus
  totalAmountVnd    Int
  subtotalVnd       Int           @default(0)
  discountAmountVnd Int           @default(0)
  paidAmountVnd     Int           @default(0)
  refundedAmountVnd Int           @default(0)
  balanceDueVnd     Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lake           Lake            @relation(fields: [lakeId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])
  fishingSession FishingSession? @relation(fields: [fishingSessionId], references: [id])
  lines                 InvoiceLine[]
  payments              Payment[]
  debts                 Debt[]
  financialTransactions FinancialTransaction[]

  @@unique([lakeId, fishingSessionId])
  @@index([lakeId, status])
  @@index([lakeId, createdAt])
}

model InvoiceLine {
  id            String   @id @default(uuid())
  invoiceId     String
  productId     String?
  fishBuybackId String?
  name          String
  unitPrice     Int
  quantity      Decimal
  totalVnd      Int
  createdAt     DateTime @default(now())

  invoice     Invoice      @relation(fields: [invoiceId], references: [id])
  product     Product?     @relation(fields: [productId], references: [id])
  fishBuyback FishBuyback? @relation(fields: [fishBuybackId], references: [id])

  @@index([createdAt])
  @@index([invoiceId, createdAt])
}

model Payment {
  id             String           @id @default(uuid())
  lakeId         String
  invoiceId      String?
  expenseId      String?
  amountVnd      Int
  method         PaymentMethod
  direction      PaymentDirection
  reversalOfId   String?
  idempotencyKey String?
  createdAt      DateTime         @default(now())

  lake       Lake      @relation(fields: [lakeId], references: [id])
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])
  expense    Expense?  @relation(fields: [expenseId], references: [id])
  reversalOf            Payment?               @relation("PaymentReversals", fields: [reversalOfId], references: [id])
  reversals             Payment[]              @relation("PaymentReversals")
  financialTransactions FinancialTransaction[]

  @@unique([lakeId, idempotencyKey])
  @@unique([lakeId, reversalOfId])
  @@index([lakeId, createdAt])
}

model Expense {
  id          String   @id @default(uuid())
  lakeId      String
  description String
  amountVnd   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lake                  Lake                   @relation(fields: [lakeId], references: [id])
  payments              Payment[]
  financialTransactions FinancialTransaction[]

  @@index([lakeId, createdAt])
}

// -----------------------------------------------------------------------------
// SHIFTS
// -----------------------------------------------------------------------------

model Shift {
  id             String    @id @default(uuid())
  lakeId         String
  startTime      DateTime
  endTime        DateTime?
  openingCashVnd Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lake   Lake         @relation(fields: [lakeId], references: [id])
  closes ShiftClose[]

  @@index([lakeId, createdAt])
}

model ShiftClose {
  id                String   @id @default(uuid())
  shiftId           String
  totalCashVnd      Int      @default(0)
  totalTransferVnd  Int      @default(0)
  totalRevenueVnd   Int      @default(0)
  totalExpenseVnd   Int      @default(0)
  fishBuybackVnd    Int      @default(0)
  otherExpenseVnd   Int      @default(0)
  actualCashVnd     Int?
  cashDifferenceVnd Int      @default(0)
  differenceReason  String?
  receivedBy        String?
  closedBy          String?
  note              String?
  createdAt         DateTime @default(now())

  shift Shift @relation(fields: [shiftId], references: [id])
}

// -----------------------------------------------------------------------------
// SYSTEM LOGGING & IDEMPOTENCY
// -----------------------------------------------------------------------------

model AuditEvent {
  id         String   @id @default(uuid())
  lakeId     String?
  entityType String
  entityId   String
  action     String
  payload    String
  createdBy  String
  createdAt  DateTime @default(now())

  lake Lake? @relation(fields: [lakeId], references: [id])

  @@index([lakeId, createdAt])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([createdBy])
  @@index([lakeId, createdBy, createdAt])
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  lakeId         String
  key            String
  responseStatus Int
  responseBody   String
  createdAt      DateTime @default(now())

  lake Lake @relation(fields: [lakeId], references: [id])

  @@unique([lakeId, key])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// SAAS SUBSCRIPTIONS & ORDERS
// -----------------------------------------------------------------------------

model SubscriptionPlan {
  id           String   @id @default(uuid())
  code         PlanTier @unique
  name         String
  priceVnd     Int
  durationDays Int      @default(30)
  maxSpots     Int?
  maxStaff     Int?
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       SubscriptionOrder[]
}

model SubscriptionOrder {
  id                String                  @id @default(uuid())
  orderCode         String                  @unique
  organizationId    String
  lakeId            String
  planCode          PlanTier
  amountVnd         Int
  durationDays      Int                     @default(30)
  status            SubscriptionOrderStatus @default(PENDING)
  paymentMethod     String                  @default("VIETQR")
  paidAt            DateTime?
  bankRef           String?
  rawWebhookPayload String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id])
  lake              Lake                    @relation(fields: [lakeId], references: [id])
  plan              SubscriptionPlan        @relation(fields: [planCode], references: [code])

  @@index([lakeId, status])
  @@index([orderCode])
}

// -----------------------------------------------------------------------------
// PHONE AUTHENTICATION (OTP)
// -----------------------------------------------------------------------------

model OtpCode {
  id        String   @id @default(uuid())
  phone     String   @unique
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
}

model OtpDeliveryLog {
  id           String    @id @default(uuid())
  phone        String
  maskedPhone  String
  provider     String
  status       String
  ipAddress    String?
  deviceHash   String?
  costVnd      Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())
  verifiedAt   DateTime?

  @@index([phone])
  @@index([createdAt])
  @@index([status])
}

// -----------------------------------------------------------------------------
// SAAS FINANCIAL MANAGEMENT (PHÂN HỆ QUẢN LÝ TÀI CHÍNH & THU CHI)
// -----------------------------------------------------------------------------

model FinancialCategory {
  id           String           @id @default(uuid())
  lakeId       String
  type         PaymentDirection // IN = Thu, OUT = Chi
  name         String
  code         String?
  color        String?          @default("#0284c7")
  icon         String?          @default("Tag")
  parentId     String?
  isSystem     Boolean          @default(false)
  isActive     Boolean          @default(true)
  displayOrder Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  lake         Lake                 @relation(fields: [lakeId], references: [id])
  parent       FinancialCategory?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     FinancialCategory[]  @relation("CategoryHierarchy")
  transactions FinancialTransaction[]

  @@unique([lakeId, type, name])
  @@index([lakeId, type, isActive])
  @@index([lakeId, createdAt])
}

model FinancialAccount {
  id                 String               @id @default(uuid())
  lakeId             String
  name               String
  accountType        FinancialAccountType @default(CASH)
  accountNumber      String?
  bankName           String?
  initialBalanceVnd  Int                  @default(0)
  currentBalanceVnd  Int                  @default(0)
  isDefault          Boolean              @default(false)
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  lake               Lake                 @relation(fields: [lakeId], references: [id])
  transactions       FinancialTransaction[]
  transfersFrom      FundTransfer[]       @relation("TransferFromAccount")
  transfersTo        FundTransfer[]       @relation("TransferToAccount")
  reconciliations    ReconciliationRecord[]

  @@unique([lakeId, name])
  @@index([lakeId, isActive])
  @@index([lakeId, createdAt])
}

model FinancialTransaction {
  id               String                     @id @default(uuid())
  lakeId           String
  code             String                     // PT-xxx or PC-xxx
  type             FinancialTransactionType   // RECEIPT, EXPENSE
  amountVnd        Int
  paymentMethod    PaymentMethod              @default(CASH)
  status           FinancialTransactionStatus @default(APPROVED)
  categoryId       String?
  accountId        String?
  customerId       String?
  supplierName     String?
  payerOrReceiver  String?
  description      String
  note             String?
  invoiceId        String?
  expenseId        String?
  paymentId        String?
  idempotencyKey   String?
  attachments      String?                    // JSON array of file URLs
  createdById      String
  approvedById     String?
  cancelledById    String?
  cancelledReason  String?
  transactionDate  DateTime                   @default(now())
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  lake             Lake                       @relation(fields: [lakeId], references: [id])
  category         FinancialCategory?         @relation(fields: [categoryId], references: [id])
  account          FinancialAccount?          @relation(fields: [accountId], references: [id])
  customer         Customer?                  @relation(fields: [customerId], references: [id])
  invoice          Invoice?                   @relation(fields: [invoiceId], references: [id])
  expense          Expense?                   @relation(fields: [expenseId], references: [id])
  payment          Payment?                   @relation(fields: [paymentId], references: [id])
  createdBy        User                       @relation("CreatedTransactions", fields: [createdById], references: [id])
  approvedBy       User?                      @relation("ApprovedTransactions", fields: [approvedById], references: [id])
  debtPayments     DebtPayment[]

  @@unique([lakeId, code])
  @@unique([lakeId, idempotencyKey])
  @@index([lakeId, type, status])
  @@index([lakeId, transactionDate])
  @@index([lakeId, createdAt])
  @@index([lakeId, categoryId])
  @@index([lakeId, accountId])
  @@index([lakeId, customerId])
}

model FundTransfer {
  id             String               @id @default(uuid())
  lakeId         String
  code           String               // CK-xxx
  fromAccountId  String
  toAccountId    String
  amountVnd      Int
  feeAmountVnd   Int                  @default(0)
  note           String?
  transferredAt  DateTime             @default(now())
  createdById    String
  createdAt      DateTime             @default(now())

  lake           Lake                 @relation(fields: [lakeId], references: [id])
  fromAccount    FinancialAccount     @relation("TransferFromAccount", fields: [fromAccountId], references: [id])
  toAccount      FinancialAccount     @relation("TransferToAccount", fields: [toAccountId], references: [id])

  @@unique([lakeId, code])
  @@index([lakeId, transferredAt])
  @@index([lakeId, createdAt])
}

model Debt {
  id                 String        @id @default(uuid())
  lakeId             String
  code               String        // CN-xxx
  type               DebtType      // RECEIVABLE, PAYABLE
  customerId         String?
  supplierName       String?
  title              String
  invoiceId          String?
  totalAmountVnd     Int
  paidAmountVnd      Int           @default(0)
  remainingAmountVnd Int
  dueDate            DateTime?
  status             DebtStatus    @default(PENDING)
  note               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  lake               Lake          @relation(fields: [lakeId], references: [id])
  customer           Customer?     @relation(fields: [customerId], references: [id])
  invoice            Invoice?      @relation(fields: [invoiceId], references: [id])
  payments           DebtPayment[]

  @@unique([lakeId, code])
  @@index([lakeId, type, status])
  @@index([lakeId, customerId])
  @@index([lakeId, dueDate])
  @@index([lakeId, createdAt])
}

model DebtPayment {
  id            String                @id @default(uuid())
  lakeId        String
  debtId        String
  transactionId String?
  amountVnd     Int
  paymentMethod PaymentMethod         @default(CASH)
  paymentDate   DateTime              @default(now())
  note          String?
  createdById   String
  createdAt     DateTime              @default(now())

  debt          Debt                  @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction? @relation(fields: [transactionId], references: [id])

  @@index([lakeId, debtId])
  @@index([lakeId, paymentDate])
  @@index([lakeId, createdAt])
}

model FinancialPeriod {
  id          String    @id @default(uuid())
  lakeId      String
  name        String    // Kỳ tài chính: "Tháng 10/2026"
  startDate   DateTime
  endDate     DateTime
  isLocked    Boolean   @default(false)
  lockedAt    DateTime?
  lockedById  String?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lake        Lake      @relation(fields: [lakeId], references: [id])

  @@unique([lakeId, name])
  @@index([lakeId, isLocked])
  @@index([lakeId, startDate, endDate])
}

model ReconciliationRecord {
  id               String           @id @default(uuid())
  lakeId           String
  accountId        String
  systemBalanceVnd Int
  actualBalanceVnd Int
  differenceVnd    Int
  reason           String?
  checkedAt        DateTime         @default(now())
  checkedById      String
  createdAt        DateTime         @default(now())

  lake             Lake             @relation(fields: [lakeId], references: [id])
  account          FinancialAccount @relation(fields: [accountId], references: [id])

  @@index([lakeId, accountId])
  @@index([lakeId, checkedAt])
  @@index([lakeId, createdAt])
}

// -----------------------------------------------------------------------------
// PRINT JOBS (Cloud Print Spooler cho trạm in bàn)
// -----------------------------------------------------------------------------

enum PrintJobStatus {
  PENDING
  PRINTED
  FAILED
  EXPIRED
}

model PrintJob {
  id          String         @id @default(uuid())
  lakeId      String
  jobType     String         // "SESSION_TICKET" | "PAYMENT_RECEIPT" | "TEST"
  targetName  String?        // Tên vé / số hóa đơn (ví dụ: "Vé #A1 - Ca 5h")
  payloadJson String         // Dữ liệu vé/hóa đơn theo định dạng SessionTicketData hoặc PaymentReceiptData
  status      PrintJobStatus @default(PENDING)
  createdById String?
  createdByName String?
  printedAt   DateTime?
  printedBy   String?        // Tên trạm in bàn đã nhận lệnh
  error       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lake        Lake           @relation(fields: [lakeId], references: [id])

  @@index([lakeId, status, createdAt])
}


model Notification {
  id          String   @id @default(uuid())
  lakeId      String?
  fromUserId  String?
  toUserId    String?
  title       String?
  body        String?
  createdAt   DateTime @default(now())
  read        Boolean  @default(false)

  lake        Lake?    @relation(fields: [lakeId], references: [id])
  fromUser    User?    @relation("NotificationFrom", fields: [fromUserId], references: [id])
  toUser      User?    @relation("NotificationTo", fields: [toUserId], references: [id])
}
