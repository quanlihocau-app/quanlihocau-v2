{
	email {$ACME_EMAIL}
	# Không bật admin API ra ngoài localhost của container.
	admin off
}

{$SITE_ADDRESS:quanlihocau.com}, {$SITE_WWW:www.quanlihocau.com} {
	encode zstd gzip
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# index.html, mọi file .html, sw.js và service-worker.js.
	@documents path_regexp (\.html$)|(^/(sw|service-worker)\.js$)
	header @documents Cache-Control "no-cache, no-store, must-revalidate" {
		defer
	}

	# Trang Next không nằm dưới /_next/static. Không cache dài.
	@not_hashed not path_regexp ^/_next/static/.+
	header @not_hashed Cache-Control "no-cache, no-store, must-revalidate" {
		defer
	}

	# Chỉ file đã hash trong /_next/static mới cache dài. Service worker bị loại.
	@hashed {
		path_regexp ^/_next/static/.+
		not path_regexp /(sw|service-worker)\.js$
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable" {
		defer
	}

	# App đọc IP thật từ phần tử đầu của X-Forwarded-For.
	reverse_proxy app:3000 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}
