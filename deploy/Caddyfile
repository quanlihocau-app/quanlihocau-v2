{
	email {$ACME_EMAIL}
	# Không bật admin API ra ngoài localhost của container.
	admin off
}

# Entrypoint của ảnh Caddy thêm site theo SITE_ADDRESS.
# SITE_WWW trống thì không thêm www.quanlihocau.com và không xin chứng chỉ www.
(site) {
	encode zstd gzip
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Trang prerender (/login, /register, /bang-gia, /thiet-bi-may-in) gửi s-maxage dài.
	# Đè Cache-Control của mọi đường không phải file tĩnh. Giữ cache của app cho
	# /_next/static, /images, /icons và favicon.
	@dynamic not path /_next/static/* /images/* /icons/* /favicon.ico /favicon.svg
	header @dynamic Cache-Control "private, no-cache" {
		defer
	}

	# Chỉ file đã hash trong /_next/static mới cache dài. Service worker bị loại.
	@hashed {
		path_regexp ^/_next/static/.+
		not path_regexp /(sw|service-worker)\.js$
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable" {
		defer
	}

	# App đọc IP thật từ phần tử đầu của X-Forwarded-For.
	reverse_proxy app:3000 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}
