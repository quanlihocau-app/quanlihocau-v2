# ==============================================================================
# QUẢN LÝ HỒ CÂU V2 - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Cấu hình biến môi trường chuẩn bị cho Production (Vercel / Railway / Docker)
# LƯU Ý: Không điền mật khẩu thực tế vào file này. Copy thành .env để sử dụng.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL - Neon / Supabase / Railway / RDS)
# ------------------------------------------------------------------------------
# Chuỗi kết nối PostgreSQL hỗ trợ pooling hoặc direct connection
DATABASE_URL="postgresql://username:password@ep-host-12345.ap-southeast-1.aws.neon.tech/quanlihocau?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH / AUTHENTICATION
# ------------------------------------------------------------------------------
# URL gốc của hệ thống (Production domain hoặc localhost khi test)
NEXTAUTH_URL="https://quanlihocau.com"

# Khóa bí mật mã hóa Session JWT (Tạo bằng lệnh: openssl rand -base64 32)
NEXTAUTH_SECRET="your-super-secret-random-key-at-least-32-chars-long"

# ------------------------------------------------------------------------------
# 3. BANKING & WEBHOOK (Techcombank / VietQR / Casso / SePay)
# ------------------------------------------------------------------------------
# Khóa bí mật xác thực webhook từ cổng ngân hàng (khớp với header x-api-key hoặc Bearer token)
BANK_WEBHOOK_SECRET="your-secure-bank-webhook-secret-token"

# Thông tin tài khoản nhận thanh toán VietQR Techcombank (Mặc định trong code nếu không đặt)
NEXT_PUBLIC_BANK_ID="TCB"
NEXT_PUBLIC_BANK_BIN="970407"
NEXT_PUBLIC_BANK_NAME="Techcombank"
NEXT_PUBLIC_BANK_ACCOUNT="8799999990"
NEXT_PUBLIC_BANK_ACCOUNT_NAME="TRAN ANH HUAN"
NEXT_PUBLIC_HOTLINE="0855550813"

# ------------------------------------------------------------------------------
# 4. SMS OTP PROVIDER (Tùy chọn - Dùng cho nhà mạng eSMS / SpeedSMS / Twilio)
# ------------------------------------------------------------------------------
# Nếu chưa cấu hình, trong môi trường dev hệ thống sẽ log mã OTP ra terminal console
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SECRET=""
SMS_BRANDNAME="QuanLyHoCau"

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
NODE_ENV="production"
